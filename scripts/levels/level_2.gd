extends "res://scripts/level_base.gd"
## 关卡 2 ——「火雨」（倒 V 型：左侧下行 → 最低点检查点 → 右侧阶梯上行 → 浮台火种 → 冰墙 → 出口）
##
## 整关只有一条主线，最低点是唯一的主要目标区：
##   入口地面 100~450（地火 450，固定 4 秒周期，相位 0.5）
##   走廊 450~800（低天花板已删，可跳）
##   下行 800~980 → 960~1100 → 最低点地面 900~1300
##   最低点：天火 1040（悬空，固定周期）、检查点 1240
##   上行 5 级台阶 1300~2210（每级升 70）；第 1、2 级接成一条，接缝处有横向火，第 4 级上有第二处地火
##   浮台 1840~1990（顶 780，与高处平台等高）：火种 1915；从第 5 级台阶向左跳上去
##   高处平台 2250~2450：冰墙 2350、终点 2420
##
## 相对初版坐标的调整（初版有几处物理上会卡住）：
##   · 低天花板平台已删除（2026-10-30），450~800 地板保留，走廊现在可跳；
##   · 下行平台右移，避开走廊正下方，保证每段都有完整落点；
##   · 上行阶梯不再互相重叠：第 1、2 级接成一条，其余每级 150 宽、间隔 40；
##   · 高处平台接在阶梯右侧（2250~2450）。初版 1450~1850 正好压在
##     平台 5 上方，中间只有 60 像素，物理上无法站立。

func _ready() -> void:
	level_number = 2
	level_title = "火雨"
	world_size = Vector2(2550, 1400)
	start_position = Vector2(120, 730)
	finish_position = Vector2(2420, 780)
	super()

func _build() -> void:
	# =================================================================
	# 第一段：左侧下行（教学）
	# =================================================================
	_add_platform(Vector2(275, 800), 350, 40)    # 入口地面 100~450，顶面 780
	_add_platform(Vector2(625, 800), 350, 40)    # 走廊地板 450~800，顶面 780
	# 低天花板平台已删除（2026-10-30，用户删的）：走廊现在净空 260，可以跳。
	# （原低顶在 y=630，底面 650，净空 130）

	# 地火 1：x450（走廊入口），固定周期（灭 2.6 + 预警 0.4 + 着火 1.0 = 4 秒），
	# 相位 0.5（开局 1 秒后第一次着火），跳到空中也过不去，只能等它灭。
	_add_flame_jet(Vector2(450, 780), true, 0.5, 110.0, false, 2.6)

	# 压力板与起点天火已删除：这段走廊不再有踩板机关，低天花板也已删除。

	# 两级下行：每级都有完整的落脚面，不走纯自由落体
	_add_platform(Vector2(890, 920), 180, 40)    # 下行平台 1：800~980，顶面 900
	_add_platform(Vector2(1030, 1030), 140, 40)  # 下行平台 2：960~1100，顶面 1010

	# =================================================================
	# 第二段：最低点（唯一主要目标区）
	# =================================================================
	_add_platform(Vector2(1100, 1220), 400, 40)  # 底层地面 900~1300，顶面 1200

	# 史莱姆原位换成天火：固定周期（灭 1.5 → 预警 0.9 → 烧 1.5），向下、长 130。
	# 这里没有天花板，喷口悬在史莱姆原位上方，火焰正好够到地面 1200。
	var sky: Area2D = _add_flame_jet(Vector2(1040, 1070), false, 0.0, 130.0, false, 1.5)
	sky.set("warn_time", 0.9)
	sky.set("on_time", 1.5)
	# 最低点只放检查点：死亡后回到这里，不用重爬前半段
	_add_checkpoint(Vector2(1240, 1200))

	# =================================================================
	# 第三段：右侧上行（阶梯式，不连续陡跳）
	# =================================================================
	_add_platform(Vector2(1395, 1150), 190, 40)  # 上行平台 1：1300~1490，顶面 1130（右缘与平台 2 相接）
	_add_platform(Vector2(1565, 1080), 150, 40)  # 上行平台 2：1490~1640，顶面 1060
	# 横向火：装在第 2 级左缘、朝左喷，覆盖第 1、2 级的接缝。
	# 配置同天火：灭 1.5 / 预警 0.9 / 烧 1.5；长 130，横向扫过第 1 级右半段。
	var side_fire: Area2D = _add_flame_jet(Vector2(1490, 1100), false, 0.0, 130.0, false, 1.5)
	side_fire.rotation_degrees = 90.0
	side_fire.set("warn_time", 0.9)
	side_fire.set("on_time", 1.5)
	_add_platform(Vector2(1755, 1010), 150, 40)  # 上行平台 3：1680~1830，顶面 990
	_add_platform(Vector2(1945, 940), 150, 40)   # 上行平台 4：1870~2020，顶面 920
	_add_platform(Vector2(2135, 870), 150, 40)   # 上行平台 5：2060~2210，顶面 850

	# 第二处地火：放在第 4 级左缘，跳上来时要判断落点，不能落在火里
	_add_flame_jet(Vector2(1905, 920), true, 0.0, 110.0, false, 2.6)

	# 与高处平台等高的浮台：火种在平台中间，从第 5 级台阶向左跳上来拿
	_add_platform(Vector2(1915, 800), 150, 40)   # 浮台：1840~1990，顶面 780
	_add_element_orb(Vector2(1915, 770), Element.Kind.FIRE)

	# =================================================================
	# 第四段：高处出口（短水平连接段 + 冰墙 + 终点）
	# =================================================================
	_add_platform(Vector2(2350, 800), 200, 40)   # 高处连接平台：2250~2450，顶面 780
	_add_ice_barrier(Vector2(2350, 680), Vector2(40, 200))
	_add_finish_flag(finish_position)

	# =================================================================
	# 可选收集 / 提示 / 兜底
	# =================================================================
	_add_coin(Vector2(250, 750))
	_add_coin(Vector2(940, 1170))
	_add_coin(Vector2(2100, 820))

	_add_death_zone(1500, -200, 2550)
