extends "res://scripts/level_base.gd"
## 关卡 9 ——「分岔」（先冻池过桥；过桥后可以从冰桥右端跳下去走下层史莱姆支线）
##
## ★ 2026-10-25 修正：上层平台原来顶面 640、下层地面 780，中间只剩 100 净空。
##   玩家一跳就撞头（最多只能升 58），下层根本没法跳过史莱姆。
##   按玩家真实尺寸算：碰撞盒高 42、摸高 92，再加上 1.8 倍精灵的视觉高度 86，
##   下层要能"完整跳一次"，上层底面至少要离地 86 + 92 ≈ 178（这里给到 220）。
##
## ★ 2026-10-29 按新设计表重排（"平台和地形坐标"那张表）：
##   · 起点平台 -100~350（顶 520），末端直接接冻结水池；
##   · 冻结水池 350~590：水面 600（比桥面低 80），水底 670，没冻住掉进去直接死；
##     冻住后冰桥浮到 520，和起点/上层平台齐平，这是一眼能看懂的路；
##   · 上层平台 590~950（顶 520）→ 冰桥 950~1400（顶 520，冰面打滑，含地火）；
##   · 下层平台 400~1400（顶 780）：从冰桥右端（1400）跳下去就是史莱姆走廊，金币；
##   · 汇合 A 1300~1800、B 1900~2300（中间 100 缺口，门就在缺口上）；
##   · 设计表把 A/B/终点写成"顶 520"，但下层 780 的路线跳不上去（摸高只有 92，
##     差 260），而且表自己也写"上层进入后可落下至共同区域" —— 说明共同区域
##     就在下面那层。所以 A/B/终点保持 780，和现有实现、和"落下"语义一致。
##   · 水池宽度：表里是 150（350~500）。实测满速横跳约 171 像素，150 能直接跳过去，
##     按表的备注"跳得过去就扩大水池"加宽到 240（350~590），上层平台左端随之从 500
##     挪到 590（仍宽 360，放 2 枚金币绰绰有余）。

func _ready() -> void:
	level_number = 9
	level_title = "分岔"
	world_size = Vector2(2400, 1100)
	start_position = Vector2(100, 480)
	finish_position = Vector2(2250, 779)
	super()


func _subtitle() -> String:
	return "先拿冰冻住水池过桥；过桥后跳下去，就是下层史莱姆走廊。"


func _intro_hint() -> String:
	return "先捡冰（起点左端）冻住水池。过桥后跳下可走下层，汇合后火种开门。"


func _build() -> void:
	# ---- 起点平台（顶面 520，右端 350 正好接水池）----
	_add_platform(Vector2(125, 540), 450, 40)    # -100~350，顶 520

	# ---- 冻结水池：水面 600（比桥面低 80），冻住后冰桥升到 520 ----
	# 宽 240（350~590）：150 宽的话满速横跳 171 就能直接跳过去，冰就白拿了。
	# 参数：位置 / 宽度 / 水面下沉量 / 落水即死 / 水体深度
	#   水面 = 池子 y + 下沉量 = 600；水底 = 水面 + 深度 = 670 → 视觉坑高 150。
	#   嫌坑太高就调小最后一个数（下限 20）；下沉量 + 深度 别超过 210，
	#   否则水底会压到下层走廊（顶 780，玩家头顶 738），走下层的人会被一起淹死。
	_add_freeze_pool(Vector2(470, 520), 240, 80.0, true, 70.0)
	_register_surface("static", Vector2(470, 530), 240, 20, "ice_pool（需冰冻）", Vector2.ZERO)

	# ---- 上层平台（顶面 520），末端接冰桥 ----
	_add_platform(Vector2(770, 540), 360, 40)    # 590~950，顶 520

	# ---- 冰桥（冰面材质，打滑；地火在 1 倍处 = 1250）----
	_add_ice_platform(Vector2(1175, 540), 450, 40)   # 950~1400，顶 520
	_add_flame_jet(Vector2(1250, 520), true, 0.0)

	# ---- 下层：从起点平台右端掉下去就是史莱姆走廊 ----
	# 顶面 780，和上层底面 560 之间净空 220，起跳不会被挡
	_add_platform(Vector2(900, 800), 1000, 40)   # 400~1400，顶 780

	# ---- 汇合 ----
	_add_platform(Vector2(1550, 800), 500, 40)   # 1300~1800，顶 780
	_add_platform(Vector2(2100, 800), 400, 40)   # 1900~2300，顶 780

	_add_sign(Vector2(330, 440), "水池：拿冰冻住再走 / 过桥后跳下走下层")

	# 冰球放在起点平台左边缘往右 20 像素（平台 -100~350，所以 x = -100 + 20 = -80）
	# 出生点 (100, 480) 往左走 180 就是，捡到再回来冻水池
	_add_element_orb(Vector2(-80, 490), Element.Kind.ICE)
	_add_element_orb(Vector2(1500, 750), Element.Kind.FIRE)
	_add_element_receiver(Vector2(1700, 740), Element.Kind.FIRE, "gate")
	_add_door(Vector2(1900, 680), "gate", Vector2(40, 200))

	_add_coin(Vector2(700, 480))
	_add_coin(Vector2(880, 480))
	# 2026-10-28：按改进方案，上层金币从 3 枚减到 2 枚，和下层奖励价值接近
	_add_coin(Vector2(500, 750))
	_add_coin(Vector2(1200, 750))

	_add_checkpoint(Vector2(1350, 780))
	_add_walker(Vector2(700, 760), 80, 55)
	_add_walker(Vector2(1000, 760), 100, 60)
	_add_finish_flag(finish_position)
	_add_death_zone(1050, -200, 2500)
